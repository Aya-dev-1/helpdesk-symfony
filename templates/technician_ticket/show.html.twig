{% extends 'base.html.twig' %}
{% block title %}Ticket #{{ ticket.id }}{% endblock %}
{% block body %}
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Ticket #{{ ticket.id }} — {{ ticket.title ?? 'Sans titre' }}</h1>
        <a href="{{ path('tech_ticket_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
    </div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6"><span class="text-muted">Statut</span> <span class="badge bg-info">{{ ticket.status ?? '—' }}</span></div>
                        <div class="col-md-6"><span class="text-muted">Priorité</span> <span class="badge bg-warning text-dark">{{ ticket.priority ?? '—' }}</span></div>
                        <div class="col-md-6"><span class="text-muted">Assigné à</span> {{ ticket.assignedToUsername ?? '—' }}</div>
                        <div class="col-md-6"><span class="text-muted">Créé</span> {{ ticket.createdAt ? ticket.createdAt|date('d/m/Y H:i') : '—' }}</div>
                    </div>
                    <hr>
                    <h2 class="h6 mb-2">Commentaires</h2>
                    <div class="list-group mb-3">
                        {% for c in comments %}
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <div><strong>{{ c.authorUsername ?? 'Anonyme' }}</strong></div>
                                <small class="text-muted">{{ c.createdAt|date('d/m/Y H:i') }}</small>
                            </div>
                            <div class="mt-2">{{ c.content|nl2br }}</div>
                        </div>
                        {% else %}
                        <div class="list-group-item text-muted">Aucun commentaire pour l’instant.</div>
                        {% endfor %}
                    </div>
                    {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <button class="btn btn-primary mt-2">Ajouter le commentaire</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6">Mettre à jour le statut</h2>
                    <form method="post" action="{{ path('tech_ticket_update_status', {id: ticket.id}) }}">
                        <div class="input-group">
                            <select class="form-select" name="status" required>
                                {% for s in ['ouvert','en_cours','en_attente','résolu','fermé'] %}
                                    <option value="{{ s }}" {{ ticket.status == s ? 'selected' : '' }}>{{ s|capitalize }}</option>
                                {% endfor %}
                            </select>
                            <button class="btn btn-outline-primary" type="submit">Mettre à jour</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h2 class="h6">Réassigner le ticket</h2>
                    <form method="post" action="{{ path('tech_ticket_reassign', {id: ticket.id}) }}">
                        <div class="input-group">
                            <input class="form-control" name="technician_id" placeholder="ID du technicien" required>
                            <button class="btn btn-outline-warning" type="submit">Réassigner</button>
                        </div>
                        <small class="text-muted d-block mt-1">ID d’un utilisateur avec ROLE_TECHNICIAN</small>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
