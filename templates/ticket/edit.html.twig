{% extends 'base.html.twig' %}

{% block title %}Modifier le Ticket{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h4 mb-0 text-primary">Modifier le ticket</h2>
                <span class="badge bg-secondary">#{{ ticket.id }}</span>
            </div>
            <div class="card-body p-4">
                {{ include('ticket/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                
                <hr class="my-4">
                
                <div class="d-flex justify-content-between align-items-center">
                     <a href="{{ path('app_ticket_index') }}" class="text-decoration-none text-muted">
                        <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
                    </a>
                    
                    {{ include('ticket/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
