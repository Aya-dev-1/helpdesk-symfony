{% extends 'base.html.twig' %}

{% block title %}Mes Tickets{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
            <div>
                <h1 class="h2 mb-1">Mes Tickets</h1>
                <p class="text-muted">Suivez l'état de vos demandes d'assistance.</p>
            </div>
            <a href="{{ path('app_ticket_new') }}" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-2"></i>Nouveau Ticket
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4 py-3">Sujet</th>
                                <th class="py-3">Statut</th>
                                <th class="py-3">Priorité</th>
                                <th class="py-3">Date de création</th>
                                <th class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for ticket in tickets %}
                            <tr>
                                <td class="ps-4 fw-medium text-dark">{{ ticket.titre }}</td>
                                <td>
                                    <span class="badge rounded-pill
                                        {% if ticket.status == 'open' %}bg-success
                                        {% elseif ticket.status == 'in_progress' %}bg-warning text-dark
                                        {% else %}bg-secondary{% endif %}">
                                        {{ ticket.status == 'open' ? 'Ouvert' : (ticket.status == 'in_progress' ? 'En cours' : 'Fermé') }}
                                    </span>
                                </td>
                                <td>
                                    {% if ticket.priority == 'high' %}
                                        <span class="text-danger fw-bold"><i class="fa-solid fa-arrow-up me-1"></i>Haute</span>
                                    {% elseif ticket.priority == 'medium' %}
                                        <span class="text-warning fw-bold"><i class="fa-solid fa-minus me-1"></i>Moyenne</span>
                                    {% else %}
                                        <span class="text-success fw-bold"><i class="fa-solid fa-arrow-down me-1"></i>Basse</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted small">
                                    <i class="fa-regular fa-calendar me-1"></i>
                                    {{ ticket.createdAt ? ticket.createdAt|date('d/m/Y H:i') : '' }}
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        {% if ticket.status == 'open' %}
                                            <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <div class="mb-3"><i class="fa-solid fa-inbox fa-3x opacity-25"></i></div>
                                    <p class="mb-0">Aucun ticket pour le moment.</p>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
