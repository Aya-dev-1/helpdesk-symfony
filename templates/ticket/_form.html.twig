
{{ form_start(form) }}
    <div class="mb-3">
        {{ form_row(form.titre, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="mb-3">
        {{ form_row(form.description, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="mb-3">
        {{ form_row(form.priority, {'attr': {'class': 'form-select'}}) }}
    </div>
    
    <button class="btn btn-primary">{{ button_label|default('Envoyer le ticket') }}</button>
{{ form_end(form) }}
