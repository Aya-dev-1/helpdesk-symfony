{% extends 'base.html.twig' %}

{% block title %}Ajouter Notification{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Ajouter un paramètre de notification</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary mt-3">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('admin_notification_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
    {{ form_end(form) }}
</div>
{% endblock %}
