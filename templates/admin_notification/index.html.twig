{% extends 'base.html.twig' %}

{% block title %}Paramètres Notifications{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
            <div>
                <h1 class="h2 mb-1">Notifications</h1>
                <p class="text-muted">Configurez les alertes et les événements.</p>
            </div>
            <a href="{{ path('admin_notification_new') }}" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-2"></i>Ajouter
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4 py-3">ID</th>
                                <th class="py-3">Événement</th>
                                <th class="py-3">Description</th>
                                <th class="py-3">État</th>
                                <th class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for setting in notification_settings %}
                            <tr>
                                <td class="ps-4 text-muted">#{{ setting.id }}</td>
                                <td class="fw-bold text-dark">{{ setting.event }}</td>
                                <td>{{ setting.description }}</td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckCheckedDisabled" {{ setting.enabled ? 'checked' : '' }} disabled>
                                        <label class="form-check-label" for="flexSwitchCheckCheckedDisabled">
                                            {{ setting.enabled ? 'Activé' : 'Désactivé' }}
                                        </label>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a href="{{ path('admin_notification_edit', {'id': setting.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        
                                        <form method="post" action="{{ path('admin_notification_delete', {'id': setting.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce paramètre ?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ setting.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" title="Supprimer" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    Aucun paramètre trouvé.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
