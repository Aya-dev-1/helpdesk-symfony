<h1>Dashboard Admin</h1>

<div class="card">Total tickets : {{ totalTickets }}</div>
<div class="card">Temps moyen de résolution : {{ avgResolutionTime }} h</div>

<h3>Tickets par statut</h3>
<ul>
    {% for row in ticketsByStatus %}
        <li>{{ row.status }} : {{ row.total }}</li>
    {% endfor %}
</ul>

<h3>Tickets par priorité</h3>
<ul>
    {% for row in ticketsByPriority %}
        <li>{{ row.priority }} : {{ row.total }}</li>
    {% endfor %}
</ul>

<h3>Tickets par technicien</h3>
<ul>
    {% for row in ticketsByTechnician %}
        <li>{{ row.technician }} : {{ row.total }}</li>
    {% endfor %}
</ul>
<a href="{{ path('app_ticket_index') }}" class="btn btn-primary">
    Gérer les tickets
</a>
