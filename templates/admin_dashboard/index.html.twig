{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <h1 class="mt-4 mb-4">Dashboard Admin</h1>
    
    <div class="row">
        <!-- Total Tickets Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start border-primary border-4 h-100 py-2 shadow-sm">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Tickets</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ totalTickets }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ticket-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average Resolution Time Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start border-success border-4 h-100 py-2 shadow-sm">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Temps Moyen Résolution</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ avgResolutionTime|number_format(1) }} h</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Pending Actions Example -->
        <div class="col-xl-3 col-md-6 mb-4">
             <div class="card border-start border-warning border-4 h-100 py-2 shadow-sm">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Actions Requises</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Tickets by Status -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Par Statut</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        {% for row in ticketsByStatus %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="badge 
                                    {% if row.status == 'open' %}bg-success
                                    {% elseif row.status == 'in_progress' %}bg-warning
                                    {% elseif row.status == 'closed' %}bg-secondary
                                    {% else %}bg-primary{% endif %} rounded-pill">
                                    {{ row.status|capitalize }}
                                </span>
                                <span class="fw-bold">{{ row.total }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">Aucune donnée</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tickets by Priority -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Par Priorité</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        {% for row in ticketsByPriority %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                {{ row.priority|capitalize }}
                                <span class="badge bg-primary rounded-pill">{{ row.total }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">Aucune donnée</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tickets by Technician -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Par Technicien</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        {% for row in ticketsByTechnician %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                {{ row.technician }}
                                <span class="badge bg-info rounded-pill">{{ row.total }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">Aucune donnée</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-12">
             <a href="{{ path('admin_ticket_index') }}" class="btn btn-primary">
                <i class="fa-solid fa-list-check me-2"></i>Gérer tous les tickets
            </a>
        </div>
    </div>
</div>
{% endblock %}
