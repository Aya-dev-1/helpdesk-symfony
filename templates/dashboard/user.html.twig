{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Tableau de bord</h1>
        <a href="{{ path('app_ticket_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nouveau Ticket
        </a>
    </div>

    {# Cartes de statistiques #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3 shadow-sm h-100">
                <div class="card-header">Total Tickets</div>
                <div class="card-body">
                    <h2 class="card-title text-center display-4">{{ stats.total }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3 shadow-sm h-100">
                <div class="card-header text-dark">En cours</div>
                <div class="card-body">
                    <h2 class="card-title text-center display-4 text-dark">{{ stats.in_progress }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3 shadow-sm h-100">
                <div class="card-header">Résolus</div>
                <div class="card-body">
                    <h2 class="card-title text-center display-4">{{ stats.resolved }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light mb-3 shadow-sm h-100 border-primary">
                <div class="card-header">Ouverts</div>
                <div class="card-body">
                    <h2 class="card-title text-center display-4 text-primary">{{ stats.open }}</h2>
                </div>
            </div>
        </div>
    </div>

    {# Derniers tickets #}
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Mes derniers tickets</h5>
        </div>
        <div class="card-body p-0">
            {% if latest_tickets is empty %}
                <div class="p-4 text-center text-muted">
                    Aucun ticket récent.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for ticket in latest_tickets %}
                            <tr>
                                <td>#{{ ticket.id }}</td>
                                <td>{{ ticket.title }}</td>
                                <td>
                                    {% set statusClass = {
                                        'OPEN': 'bg-primary',
                                        'IN_PROGRESS': 'bg-warning text-dark',
                                        'RESOLVED': 'bg-success',
                                        'CLOSED': 'bg-secondary'
                                    } %}
                                    <span class="badge {{ statusClass[ticket.status] }}">{{ ticket.status }}</span>
                                </td>
                                <td>{{ ticket.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        <div class="card-footer bg-light text-center">
            <a href="{{ path('app_ticket_index') }}" class="text-decoration-none">Voir tous mes tickets</a>
        </div>
    </div>
{% endblock %}
